[user]
    name = nolotus
    email = nolotus@users.noreply.github.com

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Monokai Extended

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default

[alias]
    st = status
    ci = commit
    co = checkout
    br = branch
    sw = switch
    unstage = reset HEAD --
    last = log -1 HEAD
    lg = log --oneline --graph --decorate -20
    lga = log --oneline --graph --decorate --all -30
    tree = log --oneline --graph --decorate --all
    undo = reset --soft HEAD~1
    amend = commit --amend --no-edit
    bd = !branch --merged main | grep -v '^\\*\\|main\\|master' | xargs -r git branch -d

[credential]
    helper = cache --timeout=3600

[credential "https://github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential
